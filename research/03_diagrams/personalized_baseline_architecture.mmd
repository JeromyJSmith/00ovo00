graph TB
    subgraph "INDIVIDUAL-SPECIFIC BASELINES (Georgia Tech + fNIRS Insight)"
        
        subgraph "Phase 1: Onboarding (Week 1)"
            O1[Dense sampling<br/>7 days, 4 sessions/day]
            O2[Multimodal capture<br/>EEG + HRV + GSR + voice]
            O3[Contextualized tasks<br/>Stress, calm, focus, social]
        end
        
        subgraph "Phase 2: Personalized Model Training"
            P1[Individual neural mapping<br/>Reliability: 0.25 → 0.92]
            P2[Physiological baselines<br/>HRV range, GSR threshold]
            P3[Vocal signature<br/>Pitch, cadence, stress markers]
        end
        
        subgraph "Phase 3: Adaptive Thresholds"
            A1[Dynamic coherence bands<br/>Person-specific 0.6/0.85 cutoffs]
            A2[Context-aware adjustment<br/>Morning vs. evening, work vs. rest]
            A3[Longitudinal drift detection<br/>Monthly recalibration]
        end
    end
    
    subgraph "POPULATION MODEL (Baseline)"
        PM[Generic thresholds<br/>One-size-fits-all]
        PM_ACC[Accuracy: ~65%<br/>High false positives]
    end
    
    subgraph "PERSONALIZED MODEL (Palace/DTRN)"
        PER[Individual-specific thresholds<br/>Adaptive + longitudinal]
        PER_ACC[Accuracy: ~88%<br/>Low false positives]
    end
    
    O1 --> O2
    O2 --> O3
    O3 --> P1
    P1 --> P2
    P2 --> P3
    P3 --> A1
    A1 --> A2
    A2 --> A3
    
    A3 --> PER
    
    PM -.->|Old paradigm| PM_ACC
    PER -.->|New paradigm| PER_ACC
    
    style PER fill:#51cf66,stroke:#2b8a3e,stroke-width:3px
    style PM fill:#868e96,stroke:#495057,stroke-width:1px
