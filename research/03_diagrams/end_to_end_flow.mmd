    style TIER1 fill:#E8F4F8,stroke:#4A90E2,stroke-width:2px
    style TIER2 fill:#FFF4E6,stroke:#F5A623,stroke-width:2px
    style TIER3 fill:#FFE8E8,stroke:#E94B3C,stroke-width:2px
    style TIER4 fill:#F0E8FF,stroke:#9013FE,stroke-width:2px
    style TIER5 fill:#FFE8F0,stroke:#E94B3C,stroke-width:3px
    style TIER6 fill:#E8FFF0,stroke:#7ED321,stroke-width:2px
    style TIER7 fill:#FFF8E8,stroke:#F5A623,stroke-width:2px
    style TIER8 fill:#E8F0FF,stroke:#4A90E2,stroke-width:2px
    
    style S1D fill:#7ED321,stroke:#333,stroke-width:2px,color:#000
    style S2D fill:#E94B3C,stroke:#333,stroke-width:3px,color:#fff
    style S3D fill:#F5A623,stroke:#333,stroke-width:2px,color:#000
    style ISO5 fill:#9013FE,stroke:#333,stroke-width:2px,color:#fff
    
    style VDB fill:#4A90E2,stroke:#333,stroke-width:2px,color:#fff
    style GDB fill:#E94B3C,stroke:#333,stroke-width:3px,color:#fff
    style ES fill:#F5A623,stroke:#333,stroke-width:2px,color:#fff
    
    style COMPILE fill:#7ED321,stroke:#333,stroke-width:3px,color:#fff
